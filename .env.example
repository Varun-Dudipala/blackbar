VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check (public identifier). Leave empty until one exists.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Dev only: App Check debug token registered in the Firebase console. Never commit a real value.
VITE_APPCHECK_DEBUG_TOKEN=
# Dev only: "true" sets FIREBASE_APPCHECK_DEBUG_TOKEN=true so the SDK prints a new debug token to register.
VITE_APPCHECK_DEBUG=
# Dev only: "true" replaces cloud answers with a clearly labelled mock (for UI work without quota).
VITE_MOCK_CLOUD=
